<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude sensitive form data from cloud backup -->
        <exclude domain="sharedpref" path="sensitive_data.xml"/>
        <exclude domain="database" path="form_data.db"/>
    </cloud-backup>
    
    <device-transfer>
        <!-- Include form data for device transfer -->
        <include domain="sharedpref" path="form_preferences.xml"/>
    </device-transfer>
</data-extraction-rules>