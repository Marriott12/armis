# Copy this file to .env and fill in real values. .env is gitignored
# and must never be committed. shared/env.php loads it automatically.

# --- Database ---
DB_HOST=localhost
DB_NAME=armis1
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# --- SMTP / outgoing email ---
SMTP_HOST=smtp.envisagezm.com
SMTP_PORT=587
SMTP_USERNAME=support@envisagezm.com
SMTP_PASSWORD=
SMTP_FROM_EMAIL=support@envisagezm.com
SMTP_FROM_NAME=ARMIS System

# --- Bulk credential assignment (admin/bulk_assign_credentials.php) ---
# Shared temp password given to accounts on bulk creation; each account
# is forced to change it on first login (isFirstLogin=1). Rotate this
# whenever you rotate other shared secrets.
BULK_DEFAULT_PASSWORD=

# --- Session timeout (seconds) ---
# How long a session may sit idle before being force-expired. Was
# previously inconsistent: config.php said 3600 (1hr, unenforced) while
# admin_branch hardcoded its own separate 1200 (20min, actually
# enforced). Now a single value via shared/session_guard.php.
SESSION_TIMEOUT_SECONDS=1200

# --- Scalability ---
# Persistent PDO connections reduce connection setup overhead on WAMP/PHP.
DB_PERSISTENT=1

# Redis is optional. Keep disabled on a standard WAMP installation until
# the Redis server and PHP Redis extension are installed.
REDIS_ENABLED=0
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# CDN is optional. Set CDN_BASE_URL to the root URL of your CDN/static host.
CDN_ENABLED=0
CDN_BASE_URL=

# Comma-separated MySQL read-replica hosts. Leave blank on a single-server install.
DB_READ_REPLICAS=

# A load balancer is an infrastructure setting, not something PHP can create.
# Enable only after the application is deployed behind a real LB and shared
# session/cache infrastructure is configured.
LOAD_BALANCER_ENABLED=0
ARMIS_INSTANCE_ID=local-wamp-01

ARMIS_MEMORY_LIMIT=512M
ARMIS_MAX_EXECUTION_TIME=60
SLOW_QUERY_THRESHOLD=2.0
RATE_LIMIT_REQUESTS=100
